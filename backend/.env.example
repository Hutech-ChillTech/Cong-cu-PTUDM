# Server Config
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key

# Database Config (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Frontend Config
CORS_ORIGIN=http://localhost:5173

# Cloudinary - Lưu trữ hình ảnh & video
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_CLOUD_KEY=your_cloudinary_key
CLOUDINARY_CLOUD_SECRET=your_cloudinary_secret

# Firebase Admin SDK
FIREBASE_ADMIN_SDK_JSON=./firebase-admin-sdk.json
FIREBASE_PROJECT_ID=your_firebase_project_id
STORAGE_BUCKET=your_firebase_storage_bucket

# Redis - Dùng cho Cache
REDIS_URL=redis://localhost:6379

# YouTube API Config (Cần quyền quản lý để Upload và Xóa)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_with_full_scopes

# MoMo Payment
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key

# VNPay Payment
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
